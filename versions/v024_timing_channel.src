def plan(initial: dict, allowed: set[str], max_depth: int = 8) -> dict:
    refusals: list[dict] = []

    def dfs(state: dict, path: list[str], depth: int):
        if state["kind"] == "flag":
            return state, path
        if depth >= max_depth:
            return None
        for unit in UNITS:
            if unit["id"] not in allowed:
                continue
            if state["kind"] not in unit["accepts"]:
                continue
            if unit["guard"] is not None and not unit["guard"](state):
                continue
            try:
                produced = unit["fn"](state)
            except Refuse as exc:
                refusals.append({"unit": unit["id"], "reason": str(exc)})
                continue
            found = dfs(produced, path + [unit["id"]], depth + 1)
            if found is not None:
                return found
        return None

    found = dfs(initial, [], 0)
    if found is not None:
        state, path = found
        return {"ok": True, "path": path, "state": state, "refusals": refusals}
    specific = [r for r in refusals if r["reason"] != "param_extract_failed"]
    reason = specific[-1]["reason"] if specific else (
        refusals[-1]["reason"] if refusals else "no_path")
    return {"ok": False, "path": [], "refusals": refusals, "reason": reason}


