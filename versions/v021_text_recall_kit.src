     "returns": "flag", "fn": unit_crc32_brute},
    {"id": "caesar_brute", "title": "凯撒密码爆破",
     "technique": ["凯撒", "caesar", "移位", "rot", "古典密码"],
     "always": False, "accepts": {"text"}, "produces": "flag", "guard": None,
     "params": {"data": "str"}, "returns": "flag", "fn": unit_caesar_brute},
]

UNIT_INDEX = {unit["id"]: unit for unit in UNITS}


def recall(query: str, top_k: int = 6) -> list[dict]:
    """按技法关键词打分；基础设施单元单独由 always 保证，不参与竞争。"""
    text = query.casefold()
    scored: list[tuple[float, dict]] = []
    for unit in UNITS:
        if unit["always"]:
            continue
        hits = sum(1 for kw in unit["technique"] if kw.casefold() in text)
        if hits == 0:
            continue
        score = hits + hits / len(unit["technique"])
        scored.append((score, unit))
    scored.sort(key=lambda item: -item[0])
    return [unit for _, unit in scored[:top_k]]


def allowed_ids(recalled: list[dict]) -> set[str]:
    return {u["id"] for u in recalled} | {u["id"] for u in UNITS if u["always"]}


# --------------------------------------------------------------------------------------
# 规划器（DFS + 回溯，与 v020 相同）
# --------------------------------------------------------------------------------------

def plan(initial: dict, allowed: set[str], max_depth: int = 8) -> dict:
    refusals: list[dict] = []

    def dfs(state: dict, path: list[str], depth: int):
        if state["kind"] == "flag":
            return state, path
        if depth >= max_depth:
            return None
        for unit in UNITS:
            if unit["id"] not in allowed:
                continue
            if state["kind"] not in unit["accepts"]:
                continue
            if unit["guard"] is not None and not unit["guard"](state):
                continue
            try:
                produced = unit["fn"](state)
            except Refuse as exc:
                refusals.append({"unit": unit["id"], "reason": str(exc)})
                continue
            found = dfs(produced, path + [unit["id"]], depth + 1)
            if found is not None:
                return found
        return None

    found = dfs(initial, [], 0)
    if found is not None:
        state, path = found
        return {"ok": True, "path": path, "state": state, "refusals": refusals}
    specific = [r for r in refusals if r["reason"] != "param_extract_failed"]
    reason = specific[-1]["reason"] if specific else (
        refusals[-1]["reason"] if refusals else "no_path")
    return {"ok": False, "path": [], "refusals": refusals, "reason": reason}


# --------------------------------------------------------------------------------------
# 题目与文本渲染
# --------------------------------------------------------------------------------------

TEXT_TASKS = ["T1", "T2", "T3", "T4", "T5"]
SECRETS = {
    "P1": "flag{sbox_but_bijective}",
    "P2": "flag{byte_affine_here}",
    "P3": "flag{gf2_matrix_love}",
    "P4": "flag{feistel_is_linear}",
    "P5": "flag{prefix_oracle_wins}",
    "P6": "flag{blackbox_then_base64}",
    "N1": "flag{sha256_is_one_way}",
    "N2": "flag{nonlinear_mixing_x}",
    "N3": "flag{nondeterministic_v}",
}

TEMPLATES = {
    "P1": "附件是主办方提供的加密脚本 {module}。明文先做逐字节替换，使用与位置相关的 S盒，"
          "然后输出密文。密文（hex）：{cipher}",
    "P2": "附件是加密脚本 {module}，它做了逐字节仿射变换 out = a*x + b。密文（hex）：{cipher}",
    "P3": "附件是加密脚本 {module}，它把整块数据做 GF2 上的线性变换（矩阵）。密文（hex）：{cipher}",
    "P4": "附件是加密脚本 {module}，用了三轮 Feistel，轮函数是线性的。密文（hex）：{cipher}",
    "P5": "附件是校验器脚本 {module}，它只返回正确前缀的长度，请还原完整输入。",
    "P6": "附件是主办方提供的加密脚本 {module}。明文先做逐字节替换与位置相关的 S盒，"
          "恢复出的明文还要再做一次 Base64 解码才能得到 flag。密文（hex）：{cipher}",
    "N1": "附件是加密脚本 {module}，它输出的是哈希值。密文（hex）：{cipher}",
    "N2": "附件是加密脚本 {module}，做了非线性的 32 位混合。密文（hex）：{cipher}",
    "N3": "附件是加密脚本 {module}，每次调用都会换随机掩码。密文（hex）：{cipher}",
}


def text_demo_cases() -> list[dict]:
    cases = []
    flag1 = "flag{rsa_small_e_no_padding}"
    m1 = int.from_bytes(flag1.encode(), "big")
    n1 = (1 << 2048) - 0xE5B1A7C3D9F102468ACE13579BDF02468 + 1
    cases.append({"id": "T1", "kind": "text", "expected": flag1, "negative": False,
                  "note": "RSA 小公钥指数",
                  "text": f"RSA 题：n = {n1}\ne = 3\nc = {pow(m1, 3, n1)}\n明文没有 padding，求 flag。"})

    flag2 = "flag{b4se64_ch41n_1s_e4sy}"
    blob = base64.b64encode(
        base64.b64encode(base64.b64encode(flag2.encode()).decode().encode()).decode().encode()
    ).decode()
    cases.append({"id": "T2", "kind": "text", "expected": flag2, "negative": False,
                  "note": "多层 Base64",
                  "text": f"给了一串经过多层 Base64 编码的字符串，求还原明文：\n{blob}"})

    flag3 = "flag{x0r_w1th_s1ngle_byte}"
    cases.append({"id": "T3", "kind": "text", "expected": flag3, "negative": False,
                  "note": "单字节 XOR",
                  "text": "下面这段 hex 是单字节 XOR 加密的，请爆破密钥还原明文：\n"
                          + bytes(b ^ 0x5A for b in flag3.encode()).hex()})

    inner = "ctfz"
    cases.append({"id": "T4", "kind": "text", "expected": f"flag{{{inner}}}",
                  "negative": False, "note": "CRC32 爆破",
                  "text": f"ZIP 里文件的 CRC32 = 0x{zlib.crc32(inner.encode()) & 0xFFFFFFFF:08X}，"
                          "内容为 4 个小写字母，求内容。"})

    flag5 = "flag{caesar_shifts_by_13}"
    shifted = "".join(
        chr((ord(ch) - 97 + 13) % 26 + 97) if ch.islower()
        else chr((ord(ch) - 65 + 13) % 26 + 65) if ch.isupper() else ch
        for ch in flag5)
    cases.append({"id": "T5", "kind": "text", "expected": flag5, "negative": False,
                  "note": "凯撒密码",
                  "text": f"凯撒密码密文：\n{shifted}"})
    return cases


def text_negative_case() -> dict:
    return {"id": "N4", "kind": "text", "expected": None, "negative": True,
            "note": "RSA e=65537（文本题负样本）",
            "text": "RSA 题：n = 3233\ne = 65537\nc = 12345\n求 flag。"}


def blackbox_case(tid: str, module_name: str, mode: str, negative: bool,
                  note: str) -> dict:
    return {"id": tid, "kind": "oracle" if mode == "enc" else "checker",
            "module": module_name, "mode": mode, "expected": SECRETS.get(tid),
            "negative": negative, "note": note}


BLACKBOX_CASES = [
    ("P1", "p1_sbox.src", "enc", False, "逐字节 S 盒"),
    ("P2", "p2_byte_affine.src", "enc", False, "逐字节仿射"),
    ("P3", "p3_gf2.src", "enc", False, "GF(2) 矩阵"),
    ("P4", "p4_feistel.src", "enc", False, "三轮 Feistel"),
    ("P5", "p5_checker.src", "check", False, "前缀校验器"),
    ("P6", "p6_sbox_b64.src", "enc", False, "黑盒 S 盒 + Base64 组合"),
    ("N1", "n1_sha.src", "enc", True, "sha256"),
    ("N2", "n2_nonlinear.src", "enc", True, "非线性混合"),
    ("N3", "n3_random.src", "enc", True, "随机掩码"),
]


def run_case(case: dict) -> dict:
    tid = case["id"]
    entry = {"id": tid, "note": case["note"], "negative": case["negative"],
             "recovered": None, "path": [], "refusals": [], "probes": 0}
    oracle = None
    try:
        if case["kind"] == "text":
            text = case["text"]
        else:
            module = (CHAL_DIR_19 if tid == "P6" else CHAL_DIR_17) / case["module"]
            oracle = Oracle(module, case["mode"])
            if case["kind"] == "checker":
                text = TEMPLATES[tid].format(module=case["module"], cipher="")
            else:
                secret = SECRETS[tid]
                plaintext = (base64.b64encode(secret.encode())
                             if tid == "P6" else secret.encode())
                cipher = oracle.call(plaintext)
                text = TEMPLATES[tid].format(module=case["module"],
                                             cipher=cipher.hex())
        recalled = recall(text, top_k=6)
        entry["recalled"] = [u["id"] for u in recalled]
        allowed = allowed_ids(recalled)

        if case["kind"] == "text":
            initial = {"kind": "text", "text": text}
        elif case["kind"] == "checker":
            initial = {"kind": "checker", "oracle": oracle}
        else:
            initial = {"kind": "oracle", "oracle": oracle, "cipher": cipher}

        result = plan(initial, allowed)
        entry["path"] = result["path"]
        entry["refusals"] = result["refusals"]
        entry["reason"] = result.get("reason")
        if result["ok"]:
            entry["recovered"] = result["state"]["text"]
        entry["solved"] = bool(case["negative"] is False and result["ok"]
                               and entry["recovered"] == case["expected"])
        entry["refused"] = bool(case["negative"] and not result["ok"])
    finally:
        if oracle is not None:
            entry["probes"] = oracle.probes
            oracle.close()
    return entry


def main() -> None:
    import argparse

    parser = argparse.ArgumentParser(description="统一文本召回 + 契约单元库")
    parser.add_argument("--only", default=None)
    parser.add_argument("--list", action="store_true")
    args = parser.parse_args()

    if args.list:
        log(f"单元库：{len(UNITS)} 个（基础设施 {sum(1 for u in UNITS if u['always'])} 个）")
        for unit in UNITS:
            tag = "常驻" if unit["always"] else "召回"
            print(f"\n[{unit['id']}] {unit['title']}  ({tag})")
            print(f"  accepts: {sorted(unit['accepts'])} → produces: {unit['produces']}")
            print(f"  技法词 : {', '.join(unit['technique'])}")
        return

    cases = text_demo_cases() + [text_negative_case()] + [
        blackbox_case(*case) for case in BLACKBOX_CASES]
    rows = []
    for case in cases:
        if args.only and case["id"] != args.only:
            continue
        log(f"  {case['id']}: {case['note']} ...")
        row = run_case(case)
        rows.append(row)
        if row["negative"]:
            verdict = "OK(如实拒绝)" if row["refused"] else "UNEXPECTED"
            detail = row.get("reason") or ""
        else:
            verdict = "OK" if row["solved"] else "FAILED"
            detail = " → ".join(row["path"]) if row["path"] else (row.get("reason") or "")
        log(f"  {case['id']}: {verdict:12} recall={row['recalled'][:3]}  {detail}")

    positives = [r for r in rows if not r["negative"]]
    negatives = [r for r in rows if r["negative"]]
    summary = {
        "units": len(UNITS),
        "positive_total": len(positives),
        "positive_solved": sum(1 for r in positives if r["solved"]),
        "negative_total": len(negatives),
        "negative_correctly_refused": sum(1 for r in negatives if r["refused"]),
        "total_probes": sum(r["probes"] for r in rows),
    }
    log("汇总：" + json.dumps(summary, ensure_ascii=False))

    OUT_DIR.mkdir(parents=True, exist_ok=True)
    (OUT_DIR / "results.json").write_text(
        json.dumps({"summary": summary, "rows": rows}, ensure_ascii=False, indent=2),
        encoding="utf-8")

    lines = ["# EXP-0019 — 8 个黑盒单元并入文本召回库", "",
             "同一份 UNITS / recall / 规划器同时处理文本题与黑盒脚本题。", "",
             "## 汇总", "", "```json",
             json.dumps(summary, ensure_ascii=False, indent=2), "```", "",
             "## 逐题", "", "| 题 | 类型 | 结果 | 规划路径 / 原因 | 召回 | 探测数 |",
             "| --- | --- | --- | --- | --- | --- |"]
    for row in rows:
        if row["negative"]:
            mark = "✓ 如实拒绝" if row["refused"] else "✗ 不该解出"
            kind = "负样本"
            detail = row.get("reason") or "—"
        else:
            mark = "✓ 解出" if row["solved"] else "✗ 失败"
            kind = "正样本"
            detail = " → ".join(row["path"]) if row["path"] else (row.get("reason") or "—")
        lines.append(f"| {row['id']} | {kind}（{row['note']}） | {mark} | {detail} "
                     f"| {', '.join(row['recalled'][:3])} | {row['probes']} |")
    (OUT_DIR / "report.md").write_text("\n".join(lines), encoding="utf-8")
    log(f"报告：{OUT_DIR / 'report.md'}")


if __name__ == "__main__":
    main()
