# 单元库
# --------------------------------------------------------------------------------------

UNITS: list[dict] = [
    {"id": "probe_facts", "title": "黑盒基本事实", "technique": ["黑盒", "探测"],
     "always": True, "accepts": {"oracle"}, "produces": "facts", "guard": None,
     "fn": probe_facts},
    {"id": "classify_structure", "title": "按依赖矩阵分类",
     "technique": ["分类", "结构"], "always": True,
     "accepts": {"facts"}, "produces": "structure", "guard": None,
     "fn": classify_structure},
    {"id": "verify_plain", "title": "执行验证", "technique": ["验证"],
     "always": True, "accepts": {"plain"}, "produces": "verified", "guard": None,
     "fn": verify_plain},
    {"id": "bytes_to_text", "title": "verified 明文转文本", "technique": ["文本"],
     "always": True, "accepts": {"verified"}, "produces": "text", "guard": None,
     "fn": bytes_to_text},
    {"id": "invert_bytewise_affine", "title": "逐字节仿射反解",
     "technique": ["仿射", "affine", "逐字节"], "always": False,
     "accepts": {"structure"}, "produces": "plain",
     "guard": lambda s: s.get("label") == "bytewise",
     "fn": invert_bytewise_affine},
    {"id": "invert_bytewise_table", "title": "逐字节双射反解",
     "technique": ["S盒", "替换表", "逐字节", "建表"], "always": False,
     "accepts": {"structure"}, "produces": "plain",
     "guard": lambda s: s.get("label") == "bytewise",
     "fn": invert_bytewise_table},
    {"id": "invert_permutation", "title": "位置置换反解",
     "technique": ["置换", "换位", "permutation"], "always": False,
     "accepts": {"structure"}, "produces": "plain",
     "guard": lambda s: s.get("label") == "permutation",
     "fn": invert_permutation},
    {"id": "invert_gf2", "title": "GF(2) 仿射反解",
     "technique": ["GF2", "线性", "矩阵", "Feistel"], "always": False,
     "accepts": {"structure"}, "produces": "plain",
     "guard": lambda s: s.get("label") == "dense",
     "fn": invert_gf2},
    {"id": "solve_prefix_checker", "title": "前缀校验器爬坡",
     "technique": ["校验器", "checker", "前缀", "爬坡"], "always": True,
     "accepts": {"checker"}, "produces": "flag", "guard": None,
     "fn": solve_prefix_checker},
    {"id": "rsa_small_e", "title": "RSA 小公钥指数",
     "technique": ["rsa", "小公钥", "e=3", "小明文", "开三次方", "iroot", "低位指数"],
     "always": False, "accepts": {"text"}, "produces": "flag", "guard": None,
     "fn": unit_rsa_small_e},
    {"id": "base64_chain", "title": "多层 Base64",
     "technique": ["base64", "多层", "连续解码", "b64", "编码链"],
     "always": False, "accepts": {"text"}, "produces": "flag", "guard": None,
     "fn": unit_base64_chain},
    {"id": "xor_single_byte", "title": "单字节 XOR 爆破",
     "technique": ["xor", "异或", "单字节", "单字节密钥", "爆破密钥"],
     "always": False, "accepts": {"text"}, "produces": "flag", "guard": None,
     "fn": unit_xor_single_byte},
    {"id": "crc32_brute", "title": "CRC32 爆破",
     "technique": ["crc32", "校验值", "明文校验", "爆破", "zip", "文件内容"],
     "always": False, "accepts": {"text"}, "produces": "flag", "guard": None,
     "fn": unit_crc32_brute},
    {"id": "caesar_brute", "title": "凯撒爆破",
     "technique": ["凯撒", "caesar", "移位", "rot", "古典密码"],
     "always": False, "accepts": {"text"}, "produces": "flag", "guard": None,
     "fn": unit_caesar_brute},
]


def plan(initial: dict, allowed: set[str], max_depth: int = 8) -> dict:
    refusals: list[dict] = []

    def dfs(state: dict, path: list[str], depth: int):
        if state["kind"] == "flag":
            return state, path
        if depth >= max_depth:
            return None
        for unit in UNITS:
            if unit["id"] not in allowed:
                continue
            if state["kind"] not in unit["accepts"]:
                continue
            if unit["guard"] is not None and not unit["guard"](state):
                continue
            try:
                produced = unit["fn"](state)
            except Refuse as exc:
                refusals.append({"unit": unit["id"], "reason": str(exc)})
                continue
            found = dfs(produced, path + [unit["id"]], depth + 1)
            if found is not None:
                return found
        return None

    found = dfs(initial, [], 0)
    if found is not None:
        state, path = found
        return {"ok": True, "path": path, "state": state, "refusals": refusals}
    specific = [r for r in refusals if r["reason"] != "param_extract_failed"]
    reason = specific[-1]["reason"] if specific else (
        refusals[-1]["reason"] if refusals else "no_path")
    return {"ok": False, "path": [], "refusals": refusals, "reason": reason}


# --------------------------------------------------------------------------------------
# 题目
# --------------------------------------------------------------------------------------

CASES = [
    {"id": "E1", "binary": "chal_check_int", "expected": "flag{elf_prefix_int}",
     "negative": False, "note": "stdout 输出前缀长度整数"},
    {"id": "E2", "binary": "chal_check_fmt", "expected": "flag{elf_prefix_fmt}",
     "negative": False, "note": "输出 prefix=N"},
    {"id": "E3", "binary": "chal_check_exit", "expected": "flag{elf_prefix_exit}",
     "negative": False, "note": "前缀长度编码在退出码"},
    {"id": "E4", "binary": "chal_transform", "expected": "flag{elf_transform_ok}",
     "negative": False, "note": "ELF 变换程序（回归）", "old_lab": True},
    {"id": "N5", "binary": "chal_check_nosignal", "expected": None,
     "negative": True, "note": "只回 wrong 的校验器"},
    {"id": "N6", "binary": "chal_check_constant", "expected": None,
     "negative": True, "note": "输出恒为 0（不随输入变化）"},
]


def run_case(case: dict) -> dict:
    started = time.perf_counter()
    binary = (OLD_LAB if case.get("old_lab") else LAB_DIR) / case["binary"]
    entry = {"id": case["id"], "note": case["note"], "negative": case["negative"],
             "binary": case["binary"], "path": [], "refusals": [], "probes": 0}
    try:
        mode = detect_elf_interface(binary)
    except Exception as exc:  # noqa: BLE001
        entry.update({"reason": f"detect_failed:{exc!r}", "elapsed_ms":
                      round((time.perf_counter() - started) * 1000, 1)})
        entry["refused"] = bool(case["negative"])
        return entry
    entry["mode"] = mode

    if mode == "none":
        entry["reason"] = "no_prefix_signal"
        entry["refused"] = bool(case["negative"])
        entry["elapsed_ms"] = round((time.perf_counter() - started) * 1000, 1)
        return entry

    oracle = None
    try:
        if mode == "enc":
            expected = case["expected"] or "flag{probe_input}"
            author = ElfOracle(binary, mode="enc")
            try:
                cipher = author.call(expected.encode())
            finally:
                author.close()
            oracle = ElfOracle(binary, mode="enc")
            result = plan({"kind": "oracle", "oracle": oracle, "cipher": cipher},
                          {u["id"] for u in UNITS})
        else:
            oracle = ElfOracle(binary, mode=mode)
            result = plan({"kind": "checker", "oracle": oracle},
                          {u["id"] for u in UNITS})
        entry["probes"] = oracle.probes
    finally:
        if oracle is not None:
            oracle.close()

    entry["path"] = result["path"]
    entry["refusals"] = result["refusals"]
    entry["reason"] = result.get("reason")
    if result["ok"]:
        entry["recovered"] = result["state"]["text"]
        entry["solved"] = (not case["negative"]
                           and entry["recovered"] == case["expected"])
    else:
        entry["refused"] = bool(case["negative"])
    entry["elapsed_ms"] = round((time.perf_counter() - started) * 1000, 1)
    return entry


def main() -> None:
    import argparse

    parser = argparse.ArgumentParser(description="ELF 前缀接口")
    parser.add_argument("--only", default=None)
    args = parser.parse_args()

    rows = []
    for case in CASES:
        if args.only and case["id"] != args.only:
            continue
        log(f"  {case['id']}: {case['note']} ...")
        row = run_case(case)
        rows.append(row)
        if row["negative"]:
            verdict = "OK(如实拒绝)" if row.get("refused") else "UNEXPECTED"
            detail = row.get("reason") or ""
        else:
            verdict = "OK" if row.get("solved") else "FAILED"
            detail = " → ".join(row["path"]) if row["path"] else (row.get("reason") or "")
        log(f"  {case['id']}: {verdict:12} mode={row.get('mode','?'):10} "
            f"probes={row['probes']:5} {detail}")

    positives = [r for r in rows if not r["negative"]]
    negatives = [r for r in rows if r["negative"]]
    summary = {
        "positive_total": len(positives),
        "positive_solved": sum(1 for r in positives if r.get("solved")),
        "negative_total": len(negatives),
        "negative_correctly_refused": sum(1 for r in negatives if r.get("refused")),
        "total_probes": sum(r["probes"] for r in rows),
        "mean_elapsed_ms": round(sum(r["elapsed_ms"] for r in rows)
                                 / max(len(rows), 1), 1),
    }
    log("汇总：" + json.dumps(summary, ensure_ascii=False))

    OUT_DIR.mkdir(parents=True, exist_ok=True)
    (OUT_DIR / "results.json").write_text(
        json.dumps({"summary": summary, "rows": rows}, ensure_ascii=False, indent=2),
        encoding="utf-8")

    lines = ["# EXP-0021 — ELF 校验器的前缀接口", "",
             "接口检测归一成 enc / check_num / check_exit / none；"
             "前缀信号交给逐字节爬坡。", "",
             "## 汇总", "", "```json",
             json.dumps(summary, ensure_ascii=False, indent=2), "```", "",
             "## 逐题", "", "| 题 | 类型 | 接口 | 结果 | 路径 / 原因 | 探测数 |",
             "| --- | --- | --- | --- | --- | --- |"]
    for row in rows:
        if row["negative"]:
            mark = "✓ 如实拒绝" if row.get("refused") else "✗ 不该解出"
            kind = "负样本"
            detail = row.get("reason") or "—"
        else:
            mark = "✓ 解出" if row.get("solved") else "✗ 失败"
            kind = "正样本"
            detail = " → ".join(row["path"]) if row["path"] else (row.get("reason") or "—")
        lines.append(f"| {row['id']} | {kind}（{row['note']}） | {row.get('mode', '?')} "
                     f"| {mark} | {detail} | {row['probes']} |")
    (OUT_DIR / "report.md").write_text("\n".join(lines), encoding="utf-8")
    log(f"报告：{OUT_DIR / 'report.md'}")


if __name__ == "__main__":
    main()
