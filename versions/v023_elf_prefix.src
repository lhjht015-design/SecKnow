"""
v023_elf_prefix.src — 把 ELF 校验器做成真正的前缀接口

要解决的问题
    v022 的 ELF 后端只会"stdin → stdout"的变换，遇到校验器只能靠
    "输出长度不随输入变化"拒绝。但逆向题里更常见的是**校验器**：
    输入一个候选，程序告诉你对了多少 / 错在哪里。只要这个信号能被归一成
    "正确前缀长度"，逐字节爬坡就能拿到完整输入。

本版本做两件事
    1. 接口检测：对 ELF 二进制做一组探测，判定它是
         enc          输出长度 == 输入长度（变换）
         check_num    stdout 里有一个 0..len 的数字，且随输入变化
         check_exit   退出码在 0..len 之间，且随输入变化
         none         没有可用信号
    2. 前缀提取：check_num 支持纯数字、prefix=N、correct=N 等格式；
       check_exit 直接用退出码。两种情况都归一成 `oracle.call(x) -> int`，
       再交给已有的 `solve_prefix_checker` 单元逐字节爬坡。

测什么
    E1 ELF 校验器：stdout 输出前缀长度整数      → check_num，解出
    E2 ELF 校验器：输出 prefix=N               → check_num，解出
    E3 ELF 校验器：前缀长度编码在退出码里        → check_exit，解出
    E4 ELF 变换程序                            → enc（回归 v022）
    N5 只回 "wrong" 的校验器                    → no_prefix_signal
    N6 输出恒为 0 的程序                        → 信号不随输入变化，拒绝

运行
    python versions/v023_elf_prefix.src
    python versions/v023_elf_prefix.src --only E1

产出物
    experiments/EXP-0021/{lab/,results.json,report.md}
"""

from __future__ import annotations

import base64
import itertools
import json
import queue
import random
import re
import string
import subprocess
import sys
import threading
import time
import zipfile
import zlib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT_DIR = ROOT / "experiments" / "EXP-0021"
LAB_DIR = OUT_DIR / "lab"
ATT_DIR = OUT_DIR / "attachments"
OLD_LAB = ROOT / "experiments" / "EXP-0020" / "lab"
CHAL_DIR_17 = ROOT / "experiments" / "EXP-0017" / "chal"
AUTO_WORKER = ROOT / "tools" / "auto_oracle_worker.src"
ELF_WORKER = ROOT / "tools" / "elf_oracle_worker.src"

for _stream in (sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        try:
            _stream.reconfigure(encoding="utf-8", errors="replace")
        except (ValueError, OSError):
            pass


def log(message: str) -> None:
    print(f"[{time.strftime('%H:%M:%S')}] {message}", flush=True)


FLAG_RE = re.compile(r"flag\{[^}\n]{1,200}\}", re.IGNORECASE)
CHARSET = "".join(dict.fromkeys(
    string.ascii_lowercase + string.digits + "_{}" +
    string.ascii_uppercase + "!@#$%^&*()-+=[]:;,.<>?/|~ ")).encode()


def wsl_path(win_path: Path) -> str:
    resolved = Path(win_path).resolve()
    drive = resolved.drive.rstrip(":").lower()
    return f"/mnt/{drive}" + str(resolved)[2:].replace("\\", "/")


class Refuse(Exception):
    pass


class NoOracleEntry(Exception):
    pass


# --------------------------------------------------------------------------------------
# oracle 后端
# --------------------------------------------------------------------------------------

class WorkerOracle:
    def __init__(self) -> None:
        self.mode = "enc"
        self.probes = 0
        self.proc = None
        self.replies: queue.Queue[str | None] = queue.Queue()

    def _spawn(self, argv: list[str]) -> None:
        self.proc = subprocess.Popen(
            argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, text=True, bufsize=1)

    def _start_reader(self) -> None:
        threading.Thread(target=self._reader, daemon=True).start()

    def _reader(self) -> None:
        for line in self.proc.stdout:
            self.replies.put(line.strip())
        self.replies.put(None)

    def _send(self, op: str, items: list[bytes]) -> None:
        for item in items:
            self.proc.stdin.write(f"{op} {item.hex()}\n")
        self.proc.stdin.flush()
        self.probes += len(items)

    def _recv(self, count: int) -> list[str]:
        lines = []
        for _ in range(count):
            line = self.replies.get(timeout=600)
            if line is None:
                raise RuntimeError("oracle worker 退出")
            if not line.startswith("O "):
                raise RuntimeError(f"oracle worker 返回异常：{line}")
            lines.append(line[2:])
        return lines

    def call_many(self, items: list[bytes]) -> list:
        self._send("E", items)
        results = []
        for payload in self._recv(len(items)):
            results.append(bytes.fromhex(payload) if self.mode == "enc"
                           else int(payload))
        return results

    def call(self, item: bytes):
        return self.call_many([item])[0]

    def close(self) -> None:
        if self.proc is None:
            return
        try:
            self.proc.stdin.close()
        except OSError:
            pass
        try:
            self.proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.proc.kill()


class AutoOracle(WorkerOracle):
    def __init__(self, path: Path) -> None:
        super().__init__()
        self._spawn([sys.executable, "-u", str(AUTO_WORKER), str(path)])
        line = self.proc.stdout.readline().strip()
        if not line.startswith("MODE "):
            raise NoOracleEntry("handshake_failed")
        self.mode = line.split(" ", 1)[1]
        if self.mode == "none":
            raise NoOracleEntry("no_enc_or_check")
        self._start_reader()


def parse_prefix_number(stdout: bytes, input_len: int) -> int:
    """把 stdout 归一成 0..input_len 的前缀长度；失败返回 -1。"""
    text = stdout.decode("utf-8", "replace").strip()
    if text.isdigit():
        value = int(text)
        return value if 0 <= value <= input_len else -1
    match = re.search(r"(?:prefix|correct|right|ok)\s*[=:]\s*(\d+)", text, re.I)
    if match:
        value = int(match.group(1))
        return value if 0 <= value <= input_len else -1
    numbers = [int(n) for n in re.findall(r"\d+", text)]
    valid = [n for n in numbers if 0 <= n <= input_len]
    return valid[-1] if valid else -1


class ElfOracle(WorkerOracle):
    """ELF 后端：enc / check_num / check_exit 三种模式。"""

    def __init__(self, path: Path, mode: str = "enc") -> None:
        super().__init__()
        self.mode = mode
        self._spawn(["wsl", "-e", "python3", wsl_path(ELF_WORKER),
                     wsl_path(path)])
        self._start_reader()

    def raw_many(self, items: list[bytes]) -> list[tuple[bytes, int]]:
        self._send("R", items)
        results = []
        for payload in self._recv(len(items)):
            hexpart, code = payload.split("|", 1)
            results.append((bytes.fromhex(hexpart), int(code)))
        return results

    def call_many(self, items: list[bytes]) -> list:
        if self.mode == "enc":
            return super().call_many(items)
        raw = self.raw_many(items)
        results = []
        for item, (stdout, code) in zip(items, raw):
            if self.mode == "check_exit":
                results.append(code)
            else:
                results.append(parse_prefix_number(stdout, len(item)))
        return results


def detect_elf_interface(path: Path) -> str:
    """探测 ELF 的可用接口：enc / check_num / check_exit / none。"""
    probes = [b""] + [bytes([c]) for c in CHARSET] + [b"A" * k for k in range(1, 5)]
    probes.append(probes[1])       # 重复一个，检查确定性
    oracle = ElfOracle(path, mode="raw")
    try:
        raw = oracle.raw_many(probes)
    finally:
        oracle.close()

    if raw[-1] != raw[1]:
        return "none"

    body = list(zip(probes[:-1], raw[:-1]))
    nonempty = [(item, stdout) for item, (stdout, _code) in body if item]
    if nonempty and all(len(stdout) == len(item) for item, stdout in nonempty):
        return "enc"

    num_scores = [parse_prefix_number(stdout, len(item))
                  for item, (stdout, _code) in body]
    if all(0 <= score <= len(item) for score, item in zip(num_scores, probes[:-1])) \
            and len(set(num_scores)) >= 2:
        return "check_num"

    codes = [code for _item, (_stdout, code) in body]
    if all(0 <= code <= len(item) for code, item in zip(codes, probes[:-1])) \
            and len(set(codes)) >= 2:
        return "check_exit"

    return "none"


# --------------------------------------------------------------------------------------
# 单元实现
# --------------------------------------------------------------------------------------

def gf2_solve(columns: list[int], target: int, nbits: int) -> int | None:
    rows: list[tuple[int, int]] = []
    for bit in range(nbits):
        row = 0
        for j, column in enumerate(columns):
            if (column >> bit) & 1:
                row |= 1 << j
        rows.append((row, (target >> bit) & 1))
    pivot_of: dict[int, int] = {}
    position = 0
    for column in range(nbits):
        pivot = None
        for candidate in range(position, len(rows)):
            if (rows[candidate][0] >> column) & 1:
                pivot = candidate
                break
        if pivot is None:
            continue
        rows[position], rows[pivot] = rows[pivot], rows[position]
        for index in range(len(rows)):
            if index != position and ((rows[index][0] >> column) & 1):
                rows[index] = (rows[index][0] ^ rows[position][0],
                               rows[index][1] ^ rows[position][1])
        pivot_of[column] = position
        position += 1
    for index in range(position, len(rows)):
        if rows[index][0] == 0 and rows[index][1] == 1:
            return None
    if len(pivot_of) < nbits:
        return None
    solution = 0
    for column, index in pivot_of.items():
        if rows[index][1]:
            solution |= 1 << column
    return solution


def probe_facts(state: dict) -> dict:
    oracle, cipher = state["oracle"], state["cipher"]
    n = len(cipher)
    zero = bytes(n)
    first, second = oracle.call_many([zero, zero])
    if first != second:
        raise Refuse("nondeterministic")
    lengths = sorted({1, 2, 3, 4, 5, 8, 13, 16, 21, n})
    outputs = oracle.call_many([bytes(length) for length in lengths])
    if any(len(o) != L for L, o in zip(lengths, outputs)):
        raise Refuse("not_length_preserving")
    probes = []
    for i in range(n):
        item = bytearray(n)
        item[i] = 0xFF
        probes.append(bytes(item))
    outs = oracle.call_many(probes)
    changed = [[j for j in range(n) if outs[i][j] != first[j]] for i in range(n)]
    return {"kind": "facts", "oracle": oracle, "cipher": cipher, "n": n,
            "base": first, "changed": changed,
            "diagonal": all(changed[i] == [i] for i in range(n)),
            "permutation": (all(len(row) == 1 for row in changed)
                            and len({row[0] for row in changed}) == n)}


def classify_structure(state: dict) -> dict:
    if state["diagonal"]:
        label = "bytewise"
    elif state["permutation"]:
        label = "permutation"
    else:
        label = "dense"
    return {**state, "kind": "structure", "label": label}


def invert_bytewise_affine(state: dict) -> dict:
    oracle, n, base = state["oracle"], state["n"], state["base"]
    ones, mids, v37, vc4 = [], [], [], []
    for i in range(n):
        for store, value in ((ones, 0x01), (mids, 0x9E)):
            item = bytearray(n)
            item[i] = value
            store.append(bytes(item))
        item = bytearray(n)
        item[i] = 0x37
        v37.append(bytes(item))
        item = bytearray(n)
        item[i] = 0xC4
        vc4.append(bytes(item))
    o1 = oracle.call_many(ones)
    om = oracle.call_many(mids)
    o37 = oracle.call_many(v37)
    oc4 = oracle.call_many(vc4)
    slopes = [(o1[i][i] - base[i]) & 0xFF for i in range(n)]
    if not all(om[i][i] == (slopes[i] * 0x9E + base[i]) & 0xFF
               and o37[i][i] == (slopes[i] * 0x37 + base[i]) & 0xFF
               and oc4[i][i] == (slopes[i] * 0xC4 + base[i]) & 0xFF
               for i in range(n)):
        raise Refuse("affine_not_applicable")
    if not all(slope & 1 for slope in slopes):
        raise Refuse("affine_slope_not_invertible")
    plain = bytearray(n)
    for i in range(n):
        inverse = pow(slopes[i], -1, 256)
        plain[i] = (inverse * ((state["cipher"][i] - base[i]) & 0xFF)) & 0xFF
    return {**state, "kind": "plain", "plain": bytes(plain)}


def invert_bytewise_table(state: dict) -> dict:
    oracle, n = state["oracle"], state["n"]
    tables = []
    for i in range(n):
        batch = []
        for value in range(256):
            item = bytearray(n)
            item[i] = value
            batch.append(bytes(item))
        results = oracle.call_many(batch)
        column = bytes(results[value][i] for value in range(256))
        if len(set(column)) != 256:
            raise Refuse("not_bijective")
        tables.append(column)
    plain = bytearray(n)
    for i in range(n):
        lookup = bytearray(256)
        for value in range(256):
            lookup[tables[i][value]] = value
        plain[i] = lookup[state["cipher"][i]]
    return {**state, "kind": "plain", "plain": bytes(plain)}


def invert_permutation(state: dict) -> dict:
    oracle, n, base = state["oracle"], state["n"], state["base"]
    probes = []
    for i in range(n):
        item = bytearray(n)
        item[i] = 0xA5
        probes.append(bytes(item))
    outs = oracle.call_many(probes)
    mapping = [None] * n
    for i in range(n):
        hits = [j for j in range(n) if outs[i][j] != base[j]]
        if len(hits) != 1 or ((outs[i][hits[0]] ^ base[hits[0]]) != 0xA5):
            raise Refuse("permutation_not_found")
        mapping[hits[0]] = i
    if any(m is None for m in mapping):
        raise Refuse("permutation_not_found")
    plain = bytearray(n)
    for j in range(n):
        plain[mapping[j]] = state["cipher"][j] ^ base[j]
    return {**state, "kind": "plain", "plain": bytes(plain)}


def invert_gf2(state: dict) -> dict:
    oracle, n = state["oracle"], state["n"]
    nbits = 8 * n
    basis = []
    for bit in range(nbits):
        item = bytearray(n)
        item[bit // 8] |= 1 << (bit % 8)
        basis.append(bytes(item))
    outs = oracle.call_many(basis)
    zero_value = int.from_bytes(state["base"], "little")
    columns = [int.from_bytes(out, "little") ^ zero_value for out in outs]
    rng = random.Random(0x5EC)
    for _ in range(6):
        x1 = bytes(rng.getrandbits(8) for _ in range(n))
        x2 = bytes(rng.getrandbits(8) for _ in range(n))
        x12 = bytes(a ^ b for a, b in zip(x1, x2))
        o1, o2, o12 = oracle.call_many([x1, x2, x12])
        predicted = (int.from_bytes(o1, "little")
                     ^ int.from_bytes(o2, "little") ^ zero_value)
        if predicted != int.from_bytes(o12, "little"):
            raise Refuse("structure_unknown")
    target = int.from_bytes(state["cipher"], "little") ^ zero_value
    solution = gf2_solve(columns, target, nbits)
    if solution is None:
        raise Refuse("not_invertible")
    return {**state, "kind": "plain", "plain": solution.to_bytes(n, "little")}


def solve_prefix_checker(state: dict) -> dict:
    oracle = state["oracle"]
    current = b""
    for _ in range(64):
        found = None
        for char in CHARSET:
            if oracle.call(current + bytes([char])) > len(current):
                found = bytes([char])
                break
        if found is None:
            raise Refuse("checker_stuck")
        current += found
        if current.endswith(b"}") and oracle.call(current) == len(current):
            return {**state, "kind": "flag",
                    "text": current.decode("utf-8", "replace"), "plain": current}
    raise Refuse("checker_maxlen")


def verify_plain(state: dict) -> dict:
    plain = state["plain"]
    if state["oracle"].call(plain) != state["cipher"]:
        raise Refuse("verify_failed")
    text = plain.decode("utf-8", "replace")
    if FLAG_RE.search(text):
        return {**state, "kind": "flag", "text": text}
    return {**state, "kind": "verified", "text": text}


def bytes_to_text(state: dict) -> dict:
    text = state["plain"].decode("utf-8", "replace").strip()
    if not text:
        raise Refuse("empty_text")
    return {"kind": "text", "text": text}


# 文本数据单元（本实验不重点用，保留统一库的完整性）
INT_RE = re.compile(r"\b(n|e|c)\s*=\s*(0x[0-9a-fA-F]+|\d+)")
LONG_B64 = re.compile(r"[A-Za-z0-9+/]{24,}={0,2}")
LONG_HEX = re.compile(r"\b[0-9a-fA-F]{24,}\b")
CRC_RE = re.compile(r"CRC32\s*=\s*0x([0-9A-Fa-f]{8})")
CRC_LEN = re.compile(r"(\d+)\s*个\s*(小写|大写)?\s*(英文字母|字母)")
CAESAR_RE = re.compile(r"\b[a-z]{4}\{[a-z0-9_]{3,}\}")


def unit_rsa_small_e(state: dict) -> dict:
    found = {name: int(value, 0) for name, value in INT_RE.findall(state["text"])}
    if not {"n", "e", "c"} <= set(found):
        raise Refuse("param_extract_failed")
    import gmpy2

    root, exact = gmpy2.iroot(found["c"], found["e"])
    if not exact:
        raise Refuse("not_perfect_power")
    raw = int(root).to_bytes((int(root).bit_length() + 7) // 8, "big")
    text = raw.decode("utf-8", errors="replace")
    if not FLAG_RE.search(text):
        raise Refuse("no_flag")
    return {"kind": "flag", "text": text}


def unit_base64_chain(state: dict) -> dict:
    candidates = LONG_B64.findall(state["text"])
    if not candidates:
        raise Refuse("param_extract_failed")
    text = max(candidates, key=len).strip()
    for _ in range(8):
        if FLAG_RE.search(text):
            return {"kind": "flag", "text": text}
        try:
            text = base64.b64decode(text, validate=True).decode("utf-8")
        except Exception:  # noqa: BLE001
            break
    if FLAG_RE.search(text):
        return {"kind": "flag", "text": text}
    raise Refuse("no_flag")


def unit_xor_single_byte(state: dict) -> dict:
    candidates = LONG_HEX.findall(state["text"])
    if not candidates:
        raise Refuse("param_extract_failed")
    raw = bytes.fromhex(max(candidates, key=len))
    for key in range(256):
        cand = bytes(b ^ key for b in raw)
        try:
            text = cand.decode("utf-8")
        except UnicodeDecodeError:
            continue
        if FLAG_RE.search(text):
            return {"kind": "flag", "text": text}
    raise Refuse("no_flag")


def unit_crc32_brute(state: dict) -> dict:
    crc = CRC_RE.search(state["text"])
    length = CRC_LEN.search(state["text"])
    if not (crc and length):
        raise Refuse("param_extract_failed")
    charset = ("abcdefghijklmnopqrstuvwxyz"
               if (length.group(2) or "小写") == "小写"
               else "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
    target = int(crc.group(1), 16)
    count = int(length.group(1))
    if count > 6:
        raise Refuse("brute_force_too_large")
    for combo in itertools.product(charset, repeat=count):
        word = "".join(combo)
        if zlib.crc32(word.encode()) & 0xFFFFFFFF == target:
            return {"kind": "flag", "text": f"flag{{{word}}}"}
    raise Refuse("no_match")


def unit_caesar_brute(state: dict) -> dict:
    candidates = CAESAR_RE.findall(state["text"])
    if not candidates:
        raise Refuse("param_extract_failed")
    text = candidates[0]
    for shift in range(26):
        cand = "".join(
            chr((ord(ch) - 97 - shift) % 26 + 97) if ch.islower()
            else chr((ord(ch) - 65 - shift) % 26 + 65) if ch.isupper()
            else ch for ch in text)
        if FLAG_RE.search(cand):
            return {"kind": "flag", "text": cand}
    raise Refuse("no_flag")


