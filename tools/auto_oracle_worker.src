"""自动 oracle worker：加载 Python 脚本，自己判断入口是 enc 还是 check。

启动时先输出一行握手：
    MODE enc    模块提供 enc
    MODE check  模块提供 check
    MODE none   两者都没有（父进程据此报 no_oracle_entry）

单发协议：
    E <hex> → O <hex>   调用 enc
    C <hex> → O <int>   调用 check
    T <hex> → O <us>    调用一次，只回耗时（微秒）

批量协议（worker 内 8 路并发）：
    Q <n> 后跟 n 行 hex → n 行 "O <us>"    计时模式
    Y <n> 后跟 n 行 hex → n 行 "O <payload>" 结果模式（hex 或整数）

注意：Python 的 CPU 密集函数受 GIL 限制，Y 批量的加速有限；
但 T/Q 的 time.sleep 会释放 GIL，时序爬坡仍能真正并行。
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import sys
import time
from concurrent.futures import ThreadPoolExecutor

POOL = ThreadPoolExecutor(max_workers=8)


def load_module(path: str):
    loader = importlib.machinery.SourceFileLoader("challenge", path)
    spec = importlib.util.spec_from_loader("challenge", loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules["challenge"] = module
    loader.exec_module(module)
    return module


def invoke(function, data: bytes):
    started = time.perf_counter()
    try:
        result = function(data)
        ok = True
    except Exception as exc:  # noqa: BLE001
        result, ok = exc, False
    return result, ok, int((time.perf_counter() - started) * 1_000_000)


def encode_result(result) -> str:
    if isinstance(result, (bytes, bytearray)):
        return bytes(result).hex()
    return str(int(result))


def main() -> None:
    module = load_module(sys.argv[1])
    function = None
    mode = "none"
    for name in ("enc", "check", "encrypt", "encode", "verify", "validate"):
        candidate = getattr(module, name, None)
        if callable(candidate):
            function = candidate
            mode = "check" if name in ("check", "verify", "validate") else "enc"
            break
    print(f"MODE {mode}", flush=True)
    if function is None:
        return

    stdin = sys.stdin
    for line in stdin:
        line = line.strip()
        if not line:
            continue
        parts = line.split(" ", 1)
        op = parts[0]
        payload = parts[1] if len(parts) > 1 else ""

        if op in ("Q", "Y"):
            count = int(payload)
            batch = []
            for _ in range(count):
                raw = stdin.readline().strip()
                batch.append(bytes.fromhex(raw) if raw else b"")
            results = list(POOL.map(lambda data: invoke(function, data), batch))
            for result, ok, elapsed in results:
                if op == "Q":
                    sys.stdout.write("O " + str(elapsed) + "\n")
                elif ok:
                    sys.stdout.write("O " + encode_result(result) + "\n")
                else:
                    sys.stdout.write("O -1\n")
            sys.stdout.flush()
            continue

        data = bytes.fromhex(payload)
        result, ok, elapsed = invoke(function, data)
        if not ok:
            sys.stdout.write("X " + repr(result) + "\n")
        elif op == "T":
            sys.stdout.write("O " + str(elapsed) + "\n")
        else:
            sys.stdout.write("O " + encode_result(result) + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
