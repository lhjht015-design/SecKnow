"""ELF oracle worker（在 WSL 内运行）：把可执行文件当黑盒。

协议：
    E <hex> → O <stdout hex>          变换模式
    R <hex> → O <stdout hex>|<rc>     原始模式：stdout + 退出码
    T <hex> → O <elapsed_us>          计时模式：只回本次执行耗时（微秒）

每个探测单独起进程——二进制不保证循环读，这是唯一通用的方式。
单次探测超时 5 秒，超时返回 X timeout。
"""

from __future__ import annotations

import subprocess
import sys
import time


def main() -> None:
    binary = sys.argv[1]
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            parts = line.split(" ", 1)
            op = parts[0]
            payload = parts[1] if len(parts) > 1 else ""
            data = bytes.fromhex(payload)
            started = time.perf_counter()
            done = subprocess.run([binary], input=data, capture_output=True,
                                  timeout=5)
            elapsed_us = int((time.perf_counter() - started) * 1_000_000)
            if op == "T":
                sys.stdout.write("O " + str(elapsed_us) + "\n")
            elif op == "R":
                # 原始模式：同时回传 stdout 与退出码，交给父进程归一成前缀长度
                sys.stdout.write("O " + done.stdout.hex() + "|"
                                 + str(done.returncode) + "\n")
            else:
                sys.stdout.write("O " + done.stdout.hex() + "\n")
        except subprocess.TimeoutExpired:
            sys.stdout.write("X timeout\n")
        except Exception as exc:  # noqa: BLE001
            sys.stdout.write("X " + repr(exc) + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
