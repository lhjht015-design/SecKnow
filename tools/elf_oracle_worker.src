"""ELF oracle worker（在 WSL 内运行）：把可执行文件当黑盒。

协议（单发）：
    E <hex> → O <stdout hex>          变换模式
    R <hex> → O <stdout hex>|<rc>     原始模式：stdout + 退出码
    T <hex> → O <elapsed_us>          计时模式：只回本次执行耗时（微秒）

协议（批量，worker 内 8 路并发）：
    Q <n> 后跟 n 行 hex → n 行 "O <elapsed_us>"
    Y <n> 后跟 n 行 hex → n 行 "O <stdout hex>|<rc>"

每个探测单独起进程——二进制不保证循环读，这是唯一通用的方式。
批量只是把"等进程"重叠起来，每个探测自身的耗时仍然独立测量。
单次探测超时 5 秒，超时返回 rc=124。
"""

from __future__ import annotations

import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

POOL = ThreadPoolExecutor(max_workers=8)


def run_one(binary: str, data: bytes) -> tuple[bytes, int, int]:
    started = time.perf_counter()
    try:
        done = subprocess.run([binary], input=data, capture_output=True,
                              timeout=5)
        stdout, code = done.stdout, done.returncode
    except subprocess.TimeoutExpired:
        stdout, code = b"", 124
    return stdout, code, int((time.perf_counter() - started) * 1_000_000)


def main() -> None:
    binary = sys.argv[1]
    stdin = sys.stdin
    for line in stdin:
        line = line.strip()
        if not line:
            continue
        parts = line.split(" ", 1)
        op = parts[0]
        payload = parts[1] if len(parts) > 1 else ""

        if op in ("Q", "Y"):
            count = int(payload)
            batch = []
            for _ in range(count):
                raw = stdin.readline().strip()
                batch.append(bytes.fromhex(raw) if raw else b"")
            try:
                results = list(POOL.map(lambda data: run_one(binary, data), batch))
                for stdout, code, elapsed in results:
                    if op == "Q":
                        sys.stdout.write("O " + str(elapsed) + "\n")
                    else:
                        sys.stdout.write("O " + stdout.hex() + "|"
                                         + str(code) + "\n")
            except Exception as exc:  # noqa: BLE001
                sys.stdout.write("X " + repr(exc) + "\n")
            sys.stdout.flush()
            continue

        data = bytes.fromhex(payload)
        stdout, code, elapsed = run_one(binary, data)
        if op == "T":
            sys.stdout.write("O " + str(elapsed) + "\n")
        elif op == "R":
            sys.stdout.write("O " + stdout.hex() + "|" + str(code) + "\n")
        else:
            sys.stdout.write("O " + stdout.hex() + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
